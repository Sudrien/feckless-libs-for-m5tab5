# SPDX-License-Identifier: MIT
# The fixture's libversions.h and libversions.tsv, row by row. DIR is the
# run's directory; NO_IDF whether it was run with LV_NO_IDF.
file(READ "${DIR}/libversions/libversions.h" h)
file(READ "${DIR}/libversions/libversions.tsv" t)
macro(want text row)
    string(FIND "${text}" "${row}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "${DIR} lacks: ${row}\n${h}\n${t}")
    endif()
endmacro()
macro(lacks text row)
    string(FIND "${text}" "${row}" at)
    if(NOT at EQUAL -1)
        message(FATAL_ERROR "${DIR} has: ${row}\n${h}\n${t}")
    endif()
endmacro()
want("${h}" "{ \"Fixture\", \"")
want("${h}" "{ \"esp_lcd_touch\", \"1.1.2\", \"Apache-2.0\" }")
want("${h}" "{ \"esp_jpeg\", \"1.3.1\", \"Apache-2.0 + TJpgDec (ChaN)\" }")
want("${h}" "{ \"feckless_keyboard\", \"cd4b91b\", \"licence not found\" }")
want("${h}" "{ \"tinyz\", \"3.0.2 (vendored)\", \"Unlicense\" }")
want("${h}" "{ \"pngle\", \"b1c6819\", \"MIT\" }")
want("${h}" "{ \"stb_image\", \"013ac3b\", \"MIT or Unlicense\" }")
want("${h}" "{ \"J40\", \"252e798\", \"public domain or MIT-0\" }")
want("${t}" "module\tcheckout\tlicence\n")
want("${t}" "esp_jpeg\t1.3.1\tApache-2.0 + TJpgDec (ChaN)\n")
want("${t}" "pngle\tb1c6819\tMIT\n")
lacks("${h}" "cmake_utilities")
if(NO_IDF)
    lacks("${h}" "ESP-IDF")
    lacks("${h}" "MurmurHash2")
    want("${h}" "#define LIBVERSIONS_COUNT (9)")
else()
    want("${h}" "{ \"ESP-IDF\", \"6.1.0\", \"Apache-2.0\" }")
    want("${h}" "{ \"World map, (c) OSM \\\"contributors\\\"\", \"2026-10-31\", \"ODbL-1.0\" }")
    want("${h}" "{ \"MurmurHash2\", \"-\", \"public domain\" }")
    want("${h}" "{ \"Bare\", \"\", \"\" }")
    want("${t}" "World map, (c) OSM \"contributors\"\t2026-10-31\tODbL-1.0\n")
    want("${t}" "Bare\t\t\n")
    want("${h}" "#define LIBVERSIONS_COUNT (13)")
    # the EXTRA rows last, in order
    string(FIND "${h}" "J40" a)
    string(FIND "${h}" "World map" b)
    string(FIND "${h}" "MurmurHash2" c)
    string(FIND "${h}" "Bare" d)
    if(NOT (a LESS b AND b LESS c AND c LESS d))
        message(FATAL_ERROR "EXTRA rows out of order\n${h}")
    endif()
endif()
message(STATUS "gencheck ${DIR}: ok")
